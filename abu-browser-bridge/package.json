{
  "name": "abu-browser-bridge",
  "version": "0.6.6",
  "description": "MCP Server that bridges Abu AI assistant with Chrome Extension for browser automation",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "pm-shawn",
  "repository": {
    "type": "git",
    "url": "https://github.com/PM-Shawn/Abu-Cowork"
  },
  "keywords": [
    "mcp",
    "browser",
    "automation",
    "chrome-extension",
    "abu"
  ],
  "bin": {
    "abu-browser-bridge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "cp ../abu-browser-shared/types.ts src/types.ts",
    "build": "tsc",
    "dev": "cp ../abu-browser-shared/types.ts src/types.ts && tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "body-parser": "^2.3.0",
    "express-rate-limit": "^8.2.2",
    "fast-uri": "^3.1.4",
    "ip-address": "^10.1.1",
    "path-to-regexp": "^8.4.0"
  }
}
